# Copy to .env (scripts/install.sh does this) and edit. .env is NEVER committed (see .gitignore).
# All values are optional: without them the demo uses the offline rule-based interpreter.

# --- OpenAI (llm_backend:=openai) ---
# Create a key at https://platform.openai.com/api-keys ; usage is billed to your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- Ollama (llm_backend:=ollama), runs locally, no key needed ---
# Install: https://ollama.com   then:  ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- ROS 2 networking (defaults set in scripts/common.sh) ---
# ROS_DOMAIN_ID=8          # use a different number per student pair in a shared lab
# ROS_LOCALHOST_ONLY=1
